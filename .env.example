PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MySQL 连接(共用你的 cPanel / 服务器 MySQL)
# 本地开发：server 启动时 dotenv 从「进程工作目录」(server/) 加载 .env，
# 请把本文件复制为 server/.env 才会生效（cPanel 则在 Node App 的环境变量面板填）。
# 生产请务必把 DB_PASSWORD / JWT_SECRET 换成自己的强随机值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=beyourdi_cms
DB_PASSWORD=Byd1234@Global
DB_NAME=beyourdi_fnb
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_IN=7d

# ⚠️ WEB_DIST_PATH 是**相对进程工作目录**的，而 cPanel/Passenger 的 CWD 就是
# Application root（即 server/）。所以填 server/public 会让 Node 去找
# server/server/public —— 不存在 → 前端整块不挂载。
# 一体化部署**不要设这个变量**，默认值 path.join(__dirname,'..','public') 就是对的。
# 仅当把前端产物放到别处时才设，且必须给绝对路径。
# WEB_DIST_PATH=/home/<cPanel用户>/fnb/server/public

# ⚠️ 在 cPanel 的 Node.js App 环境变量面板里：
#   · 不要填 PORT —— Passenger 会通过 process.env.PORT 把端口交给你，填了会冲突
#   · 不要填 DEV_NO_DB —— 那是内存 mock 后端(免 MySQL)，生产必须走 MySQL
